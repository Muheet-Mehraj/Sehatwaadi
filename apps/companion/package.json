{
  "name": "sehatwaadi-companion",
  "productName": "SehatWaadi Companion",
  "version": "0.1.0",
  "private": true,
  "description": "Order terminal for partner chemists (Windows)",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win nsis",
    "test": "vitest run"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "com.sehatwaadi.companion",
    "productName": "SehatWaadi Companion",
    "files": ["dist/**", "electron/**", "assets/**", "package.json"],
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": { "oneClick": true, "perMachine": false, "runAfterFinish": true }
  }
}
